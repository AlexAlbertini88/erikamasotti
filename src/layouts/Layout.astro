---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import BackgroundMusic from '../components/BackgroundMusic.astro';
import ContactIcon from '../components/ContactIcon.astro';
import { getImage } from 'astro:assets';
import { photos } from '../lib/photos';
import site from '../content/site.json';
import { url } from '../lib/urls';
interface Props { title: string; description: string; photoHeader?: boolean; }
const { title, description, photoHeader = true } = Astro.props;
const nav = [{ label: 'Home', path: '' }, { label: 'Chi sono', path: 'about/' }, { label: 'Servizi', path: 'services/' }, { label: 'Contatti', path: 'contacts/' }];
const current = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (path: string) => current === url(path).replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialPhoto = await getImage({ src: photos['hero.jpg'], width: 1200, format: 'jpg', quality: 85 });
---
<!doctype html>
<html lang="it" transition:animate="none">
  <head>
    <ClientRouter fallback="swap" />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#bfb1c4" />
    <title>{title} | {site.title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | ${site.title}`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(socialPhoto.src, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  </head>
  <body class:list={{ 'photo-header': photoHeader }}>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <BackgroundMusic />
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href={url()} aria-label="Erika Masotti, pagina iniziale">
          <span><span class="brand-name">{site.title}</span><span class="brand-role">{site.role}</span></span>
        </a>
        <nav class="desktop-nav" aria-label="Navigazione principale">
          {nav.map(item => <a href={url(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>Menu <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Navigazione mobile">{nav.map(item => <a href={url(item.path)} aria-current={isCurrent(item.path) ? 'page' : undefined}>{item.label}</a>)}</nav>
        </details>
      </div>
    </header>
    <script>
      import { initializeSocialAppLinks } from '../lib/social-app-links';
      initializeSocialAppLinks();
      document.addEventListener('astro:page-load', () => initializeSocialAppLinks());
    </script>
    <main id="contenuto" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div><a class="footer-name" href={url()}>{site.title}</a><p>Assistenza sociale, famiglia e inclusione.</p><p class="registration">{site.registration}</p></div>
        <div><h2>Restiamo in contatto</h2><a href={`mailto:${site.email}`}><ContactIcon name="email" /><span>{site.email}</span></a><a href={`tel:${site.phoneLink}`}><ContactIcon name="phone" /><span>{site.phone}</span></a></div>
        <div><h2>Seguimi</h2><a href={site.instagram} data-social-app="instagram" data-app-web-url={site.instagram} data-astro-reload><ContactIcon name="instagram" /><span>Instagram</span></a><a href={site.linkedin} data-social-app="linkedin" data-app-web-url={site.linkedin} data-astro-reload><ContactIcon name="linkedin" /><span>LinkedIn</span></a><a href={site.whatsapp}><ContactIcon name="whatsapp" /><span>WhatsApp</span></a></div>
      </div>
      <div class="container footer-bottom"><p>© {new Date().getFullYear()} {site.title}. Tutti i diritti riservati.</p><nav class="footer-legal" aria-label="Informative"><a href={url('privacy-policy/')}>Privacy policy</a><a href={url('cookie-policy/')}>Cookie policy</a></nav><a href="#contenuto">Torna al contenuto ↑</a></div>
    </footer>
  </body>
</html>
