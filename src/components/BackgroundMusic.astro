---
import music from '../content/music.json';
import { url } from '../lib/urls';
---
<aside transition:persist="site-music-player" class="music-player" aria-label="Musica di sottofondo" data-music-player data-initial-volume={music.initialVolume}>
  <audio id="site-music" controls controlslist="nodownload" loop preload="metadata" aria-label={`${music.title}, di ${music.author}`}>
    <source src={url(music.file)} type="audio/mpeg" />
    Il browser non supporta la riproduzione audio.
  </audio>
  <div class="music-controls" data-music-controls hidden>
    <button class="music-toggle" type="button" aria-controls="site-music" aria-pressed="false" title="Riproduci musica" data-music-toggle>
      <svg class="music-play-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="m8 5 11 7-11 7Z" /></svg>
      <svg class="music-pause-icon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6zm8 0h4v14h-4z" /></svg>
      <span class="sr-only" data-music-label>Riproduci musica</span>
    </button>
    <details class="music-settings">
      <summary aria-label="Impostazioni della musica" title="Impostazioni della musica"><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3" fill="#fffdf9"/><circle cx="15" cy="17" r="3" fill="#fffdf9"/></svg></summary>
      <div class="music-panel">
        <label class="music-volume">Volume <input data-music-volume type="range" min="0" max="100" step="1" value="15" aria-label="Volume della musica" /></label>
        <p class="music-status" data-music-status role="status" aria-live="polite">Puoi avviare o fermare la musica con il pulsante.</p>
        <p class="music-credit">{music.title} · {music.author} · <a href={music.sourceUrl}>Mixkit</a></p>
      </div>
    </details>
  </div>
</aside>
<script>
  import { initMusicPlayer } from '../lib/music-player';
  const initializeMusic = () => document.querySelectorAll<HTMLElement>('[data-music-player]').forEach(root => initMusicPlayer(root));
  initializeMusic();
  document.addEventListener('astro:page-load', initializeMusic);
</script>
