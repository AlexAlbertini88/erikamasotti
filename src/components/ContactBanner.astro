---
import { url } from '../lib/urls';
import ResponsivePhoto from './ResponsivePhoto.astro';
import site from '../content/site.json';
interface Props { quote?: string; }
const { quote = site.contactQuote } = Astro.props;
---
<section class="contact-banner" aria-labelledby="contact-heading">
  <ResponsivePhoto class="banner-background" name="incontro.jpg" alt="" />
  <div class="hero-overlay" aria-hidden="true"></div>
  <div class="container contact-banner-inner">
    <h2 id="contact-heading">“{quote}”</h2>
    <a class="button button-light" href={url('contacts/')}>Prenota una prima consulenza</a>
    <p>Uno spazio di ascolto, senza giudizi e senza impegno.</p>
  </div>
</section>
